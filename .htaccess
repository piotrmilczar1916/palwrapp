# ==========================================================================
#  palwrapp.pl — konfiguracja Apache / LiteSpeed (hosting z PHP)
#  Zastępuje netlify'owy plik _headers, który poza Netlify nic nie robi.
# ==========================================================================

# --- Kanoniczny adres: https + bez www -----------------------------------
# Musi być zgodny z <link rel="canonical"> i z sitemap.xml (https://palwrapp.pl/)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http → https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://palwrapp.pl%{REQUEST_URI} [L,R=301]

  # www → bez www
  RewriteCond %{HTTP_HOST} ^www\.palwrapp\.pl$ [NC]
  RewriteRule ^ https://palwrapp.pl%{REQUEST_URI} [L,R=301]

  # /index.html → / (jeden adres kanoniczny, bez duplikatu)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [L,R=301]
</IfModule>

# --- Nagłówki bezpieczeństwa ---------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Endpoint formularza poza indeksem Google
  <FilesMatch "^mail\.php$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# --- Typy MIME dla nowoczesnych formatów obrazu ---------------------------
# Bez tego część serwerów oddaje .avif/.webp jako application/octet-stream
# i przeglądarka nie wyświetla zdjęcia hero ani zdjęć modeli.
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

# --- Brak listowania katalogów -------------------------------------------
# Katalogi assets/ i js/ nie mają pliku index — bez tej linii serwer
# pokazałby ich zawartość każdemu odwiedzającemu.
# Jeśli hosting zwróci po wgraniu błąd 500, usuń tę jedną linię
# (oznacza to, że AllowOverride nie obejmuje dyrektywy Options).
Options -Indexes

# --- Blokada plików roboczych --------------------------------------------
# Pliki pomocnicze i podglądy, które nie powinny być publicznie dostępne
# ani trafiać do indeksu Google.
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|\.(bak|log|md|sh|psd|ai|zip|sql)$|^_redirects$|^mobile-preview-.*\.png$)">
    Require all denied
  </FilesMatch>
</IfModule>

# --- Cache przeglądarki ---------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif       "access plus 30 days"
  ExpiresByType image/webp       "access plus 30 days"
  ExpiresByType image/png        "access plus 30 days"
  ExpiresByType image/jpeg       "access plus 30 days"
  ExpiresByType image/svg+xml    "access plus 30 days"
  ExpiresByType video/mp4        "access plus 30 days"
  ExpiresByType text/css         "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# --- Kompresja ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# --- Strona błędu ---------------------------------------------------------
ErrorDocument 404 /index.html
